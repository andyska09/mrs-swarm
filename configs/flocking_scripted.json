{
  "name": "flocking_scripted",
  "algo": "maddpg",

  "env": {
    "n_pred": 3,
    "n_prey": 10,
    "episode_len": 100,
    "boundary": "torus",
    "n_neighbors": 6,

    "edge": 2.0,
    "dt": 0.1,
    "mass_pred": 1.0,
    "mass_prey": 1.0,
    "drag": 2.0,
    "stiffness": 50.0,
    "max_acc": 1.0,
    "max_ang_vel": 0.5,
    "speed_pred": 0.5,
    "speed_prey": 0.5,
    "perception_frac": 1.0,

    "radius_pred": 0.06,
    "radius_prey": 0.04,
    "heading_encoding": "unit",
    "init_speed_frac": 1.0,

    "catch_reward": 1.0,
    "cost_af": 0.01,
    "cost_ar": 0.1,
    "boundary_penalty": 0.1
  },

  "model": {
    "hidden": [64, 64, 64],
    "activation": "relu",
    "actor_output": "tanh"
  },

  "train": {
    "episodes": 2000,
    "lr_actor": 0.0001,
    "lr_critic": 0.001,
    "gamma": 0.95,
    "tau": 0.01,
    "buffer_size": 500000,
    "batch_size": 256,

    "eps": 0.1,
    "noise": 0.1,
    "expl_min": 0.05,
    "expl_decay": 0.00005,

    "optimizer": "adam",
    "learning_starts": 100,

    "scripted_predator": true,

    "actor_reg": 0.001
  }
}
