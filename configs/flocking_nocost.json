{
  "name": "flocking_nocost",
  "algo": "maddpg",
  "env": {
    "n_pred": 3,
    "n_prey": 10,
    "episode_len": 100,
    "boundary": "torus",
    "n_neighbors": 6,
    "edge": 2.0,
    "dt": 0.1,
    "mass_pred": 1.0,
    "mass_prey": 1.0,
    "drag": 2.0,
    "stiffness": 50.0,
    "max_acc": 1.0,
    "max_ang_vel": 0.5,
    "perception_frac": 1.0,
    "radius_pred": 0.06,
    "radius_prey": 0.04,
    "heading_encoding": "unit",
    "init_speed_frac": 1.0,
    "spawn": "uniform",
    "spawn_spacing": 0.0,
    "catch_reward": 1.0,
    "cost_af": 0.0,
    "cost_ar": 0.0,
    "boundary_penalty": 0.1,
    "pred_acc_scale": 1.0,
    "pred_turn_scale": 1.0,
    "max_speed_pred": 0.5,
    "max_speed_prey": 0.5
  },
  "model": {
    "hidden": [
      64,
      64,
      64
    ],
    "activation": "relu",
    "actor_output": "tanh"
  },
  "train": {
    "episodes": 2000,
    "lr_actor": 0.0001,
    "lr_critic": 0.001,
    "gamma": 0.95,
    "tau": 0.01,
    "buffer_size": 500000,
    "batch_size": 256,
    "eps": 0.1,
    "noise": 0.1,
    "expl_min": 0.05,
    "expl_decay": 5e-05,
    "optimizer": "adam",
    "learning_starts": 100,
    "n_envs": 1,
    "scripted_predator": false,
    "actor_reg": 0.001
  }
}
